def running():
    """Every oriel/colibri process alive right now, excluding this process and
    everything that spawned it — otherwise `oriel stop` kills its own shell."""
    out = subprocess.run(
        ["ps", "-Ao", "pid=,ppid=,command="], capture_output=True, text=True
    ).stdout

    rows, parent = [], {}
    for line in out.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) < 3:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        rows.append((pid, parts[2]))
        parent[pid] = ppid

    # walk up from ourselves: self, shell, terminal, everything above
    mine, cur = set(), os.getpid()
    while cur and cur not in mine:
        mine.add(cur)
        cur = parent.get(cur, 0)

    found = []
    for pid, cmd in rows:
        if pid in mine:
            continue
        low = cmd.lower()
        # Never touch the user's Oriel.app notch app — different program,
        # same name. Only ever match our own launcher script.
        is_app = "/applications/" in low
        is_launcher = (
            not is_app
            and "oriel" in low
            and ("python" in low or cmd.startswith("./oriel") or cmd.startswith("oriel"))
            and "oriel.log" not in low
        )
        if is_launcher:
            found.append((pid, "interface", cmd))
        elif re.search(r"(?:^|/)ollama serve\b", cmd):   # not its llama-server runners
            found.append((pid, "ollama", cmd))
        elif "coli serve" in cmd or "openai_server" in cmd:
            found.append((pid, "gateway", cmd))
        elif "/colibri/c/" in cmd and not cmd.rsplit("/", 1)[-1].startswith("coli "):
            found.append((pid, "engine", cmd))
    return found


def short(kind, cmd):
    """A readable one-liner for `oriel ps`."""
    if kind == "interface":
        return "oriel.ai interface"
    if kind == "gateway":
        return "colibri gateway"
    if kind == "ollama":
        return "ollama engine"
    return cmd.rsplit("/", 1)[-1].split()[0]


def cmd_ps():
    procs = running()
    print()
    st = macapp.agent_state()
    if st is None:
        say(f"{AMBER}{'login item':<11}{OFF}{DIM}not installed · `oriel install` adds it{OFF}")
    else:
        state, pid = st
        say(f"{AMBER}{'login item':<11}{OFF}{DIM}{state}{f' · pid {pid}' if pid else ''} · starts the server at login{OFF}")
    if macapp.APP.exists():
        say(f"{AMBER}{'app':<11}{OFF}{DIM}{macapp.APP}{OFF}")
    if not procs:
        say(f"{DIM}nothing running{OFF}")
        print()
        return 0
    interfaces = {pid for pid, kind, _ in procs if kind == "interface"}
    leftover = set(orphaned_engines())
    for pid, kind, cmd in procs:
        note = ""
        if kind == "ollama":
            ppid = int(subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True).stdout.strip() or 0)
            note = (" · run by oriel" if ppid in interfaces else
                    " · left over by an earlier oriel — `oriel stop` stops it" if pid in leftover else
                    " · yours: oriel uses it but never stops it")
        say(f"{AMBER}{kind:<11}{OFF}{DIM}pid {pid:<8}{OFF}{short(kind, cmd)}{DIM}{note}{OFF}")
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{OLLAMA_PORT}/api/ps", timeout=2) as r:
            loaded = json.load(r).get("models", [])
        # Ollama's size_vram counts only the GPU part; the runner process's own
        # footprint is what the Mac actually gives up (6.2 GB, not 3.2, for gemma4).
        runners = subprocess.run(["ps", "-axo", "rss=,command="], capture_output=True, text=True).stdout.splitlines()
        for m in loaded:
            blob = tokens._weights(m["name"]) or "?"
            rss = sum(int(line.split()[0]) for line in runners if "llama-server" in line and blob in line)
            size = rss * 1024 / 1e9 if rss else m.get("size_vram", 0) / 1e9
            say(f"{AMBER}{'model':<11}{OFF}{m['name']}{DIM} · {size:.1f} GB of memory"
                f" · {m.get('context_length', 0) // 1024}K window{OFF}")
    except Exception:
        pass
    print()
    return 0


def unpin_orphans():
    """Unpin models oriel pinned (keep_alive -1 → an expiry centuries out).

    Needed because a SIGKILLed interface never runs its own shutdown, which
    would leave its model holding RAM forever. Models the user loaded with an
    ordinary expiry are never touched. Returns the names it unloaded.
    """
    done = []
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{OLLAMA_PORT}/api/ps", timeout=2) as r:
            loaded = json.load(r).get("models", [])
        horizon = time.strftime("%Y", time.gmtime(time.time() + 365 * 86400))
        for m in loaded:
            if m.get("expires_at", "")[:4] > horizon and ollama_keep(m["name"], 0):
                done.append(m["name"])
    except Exception:
        pass
    return done


def cmd_stop():
    """Stop the whole tree. colibri's own `coli stop` reports success while
    leaving the engine binary alive holding a port; this does not."""
    print()
    # ollama is a shared service: never killed here, only its pinned model is
    # released.
    mine = lambda: [p for p in running() if p[1] != "ollama"]
    procs = mine()

    for pid, kind, _ in procs:
        try:
            os.kill(pid, signal.SIGTERM)
            say(f"{DIM}stopping {kind} (pid {pid}){OFF}")
        except (ProcessLookupError, PermissionError):
            pass
    for pid in orphaned_engines():
        try:
            os.kill(pid, signal.SIGTERM)
            say(f"{DIM}stopping an engine an earlier oriel left running (pid {pid}){OFF}")
        except (ProcessLookupError, PermissionError):
            pass

    if procs:
        deadline = time.time() + 8
        while time.time() < deadline and mine():
            time.sleep(0.3)
        for pid, kind, _ in mine():
            try:
                os.kill(pid, signal.SIGKILL)
                say(f"{DIM}forcing {kind} (pid {pid}){OFF}")
            except (ProcessLookupError, PermissionError):
                pass
        time.sleep(0.4)

    # Runs on every path — including "nothing running", which is exactly the
    # case after an interface was killed and left its model pinned.
    for name in unpin_orphans():
        say(f"{DIM}unloaded {name} from GPU memory{OFF}")

    left = mine()
    if left:
        say(f"{len(left)} process(es) would not die", RED)
        print()
        return 1
    if not procs:
        say(f"{DIM}nothing of ours running · RAM released{OFF}")
    else:
        say(f"{AMBER}stopped{OFF}{DIM} · RAM released · ports free{OFF}")
    if macapp.agent_state() is not None:
        say(f"{DIM}the server starts again at login, when you open the app, or with `oriel start`{OFF}")
    print()
    return 0


def orphaned_engines():
    """ollama servers an oriel launcher started and then lost (say its terminal
    was closed): their parent is launchd and their environment carries
    oriel's own settings. An ollama you run yourself is never one of these."""
    found = []
    for pid, kind, _ in running():
        if kind != "ollama":
            continue
        ppid = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        env = subprocess.run(["ps", "eww", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout.split()
        if ppid == "1" and f"OLLAMA_CONTEXT_LENGTH={CONTEXT_TOKENS}" in env and "OLLAMA_KV_CACHE_TYPE=q8_0" in env:
            found.append(pid)
    return found


def wait_serving(port=7171, seconds=60):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if already_serving(port):
            return True
        time.sleep(0.4)
    return False


def cmd_open(browser=False):
    """`oriel` once installed: make sure the background server is up, then
    open the app (or, with `oriel web`, the browser)."""
    print()
    if not already_serving(7171):
        if macapp.agent_state() is None:
            return serve_app([])          # not installed: run it here, as before
        say(f"{DIM}starting the oriel server…{OFF}")
        macapp.kickstart()
        if not wait_serving():
            say("the server didn't start — `oriel logs` shows why", RED)
            print()
            return 1
    if not browser and macapp.APP.exists():
        subprocess.run(["open", str(macapp.APP)])
        say(f"{AMBER}oriel.ai{OFF}{DIM} is open · its server runs in the background (`oriel stop` stops it){OFF}")
    else:
        webbrowser.open("http://127.0.0.1:7171")
        say(f"open     {BOLD}http://127.0.0.1:7171{OFF}")
    print()
    return 0


def cmd_install():
    print()
    say(f"{BOLD}installing oriel.ai{OFF}")
    # The login item must own the engine (to log it and restart it), and must
    # have port 7171 — so clear out anything an earlier oriel left running.
    for pid, kind, cmd in running():
        if kind == "interface":
            os.kill(pid, signal.SIGTERM)
            say(f"{DIM}stopped an oriel running in a terminal (pid {pid}){OFF}")
    for pid in orphaned_engines():
        os.kill(pid, signal.SIGTERM)
        say(f"{DIM}stopped an engine an earlier oriel left running (pid {pid}){OFF}")
    deadline = time.time() + 10
    while time.time() < deadline and (already_serving(7171) or orphaned_engines()):
        time.sleep(0.3)

    say(f"{DIM}building the Mac app (about 30 s)…{OFF}")
    try:
        app = macapp.build_app()
    except Exception as e:
        say(f"couldn't build the app: {e}", RED)
        print()
        return 1
    say(f"app      {AMBER}{app}{OFF}")
    try:
        macapp.install_agent()
    except Exception as e:
        say(f"couldn't install the login item: {e}", RED)
        print()
        return 1
    if not wait_serving():
        say("installed, but the server didn't start — `oriel logs` shows why", RED)
        print()
        return 1
    say(f"login    {AMBER}the server starts when you log in{OFF}{DIM} · logs in {LOGS}{OFF}")
    subprocess.run(["open", str(app)])
    say(f"{DIM}opened oriel.ai — it's in your Applications folder and in Spotlight from now on{OFF}")
    print()
    return 0


