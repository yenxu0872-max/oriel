def cmd_start(restart=False):
    print()
    if macapp.agent_state() is None:
        say("the background server isn't installed", RED)
        say(f"{DIM}`oriel install` sets it up · plain `oriel` runs it in this terminal{OFF}")
        print()
        return 1
    if restart:
        # A clean stop first (SIGTERM): the server unloads its model and stops
        # its engine. `launchctl kickstart -k` would kill it outright.
        for pid, kind, _ in running():
            if kind == "interface":
                os.kill(pid, signal.SIGTERM)
        deadline = time.time() + 10
        while time.time() < deadline and already_serving(7171):
            time.sleep(0.3)
    macapp.kickstart()
    if not wait_serving():
        say("the server didn't start — `oriel logs` shows why", RED)
        print()
        return 1
    say(f"{AMBER}{'restarted' if restart else 'running'}{OFF}{DIM} · http://127.0.0.1:7171{OFF}")
    print()
    return 0


