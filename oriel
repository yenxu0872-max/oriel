def running():
    """Every oriel/colibri process alive right now, excluding this process and
    everything that spawned it — otherwise `oriel stop` kills its own shell."""
    out = subprocess.run(
        ["ps", "-Ao", "pid=,ppid=,command="], capture_output=True, text=True
    ).stdout

    rows, parent = [], {}
    for line in out.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) < 3:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        rows.append((pid, parts[2]))
        parent[pid] = ppid

    # walk up from ourselves: self, shell, terminal, everything above
    mine, cur = set(), os.getpid()
    while cur and cur not in mine:
        mine.add(cur)
        cur = parent.get(cur, 0)

    found = []
    for pid, cmd in rows:
        if pid in mine:
            continue
        low = cmd.lower()
        # Never touch the user's Oriel.app notch app — different program,
        # same name. Only ever match our own launcher script.
        is_app = "/applications/" in low
        is_launcher = (
            not is_app
            and "oriel" in low
            and ("python" in low or cmd.startswith("./oriel") or cmd.startswith("oriel"))
            and "oriel.log" not in low
        )
        if is_launcher:
            found.append((pid, "interface", cmd))
        elif "ollama" in low and "serve" in low:
            found.append((pid, "ollama", cmd))
        elif "coli serve" in cmd or "openai_server" in cmd:
            found.append((pid, "gateway", cmd))
        elif "/colibri/c/" in cmd and not cmd.rsplit("/", 1)[-1].startswith("coli "):
            found.append((pid, "engine", cmd))
    return found


def short(kind, cmd):
    """A readable one-liner for `oriel ps`."""
    if kind == "interface":
        return "oriel.ai interface"
    if kind == "gateway":
        return "colibri gateway"
    if kind == "ollama":
        return "ollama (shared service — left running by `oriel stop`)"
    return cmd.rsplit("/", 1)[-1].split()[0]


def cmd_ps():
    procs = running()
    print()
    if not procs:
        say(f"{DIM}nothing running{OFF}")
        print()
        return 0
    for pid, kind, cmd in procs:
        say(f"{AMBER}{kind:<11}{OFF}{DIM}pid {pid:<8}{OFF}{short(kind, cmd)}")
    print()
    return 0


def unpin_orphans():
    """Unpin models oriel pinned (keep_alive -1 → an expiry centuries out).

    Needed because a SIGKILLed interface never runs its own shutdown, which
    would leave its model holding RAM forever. Models the user loaded with an
    ordinary expiry are never touched. Returns the names it unloaded.
    """
    done = []
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{OLLAMA_PORT}/api/ps", timeout=2) as r:
            loaded = json.load(r).get("models", [])
        horizon = time.strftime("%Y", time.gmtime(time.time() + 365 * 86400))
        for m in loaded:
            if m.get("expires_at", "")[:4] > horizon and ollama_keep(m["name"], 0):
                done.append(m["name"])
    except Exception:
        pass
    return done


def cmd_stop():
    """Stop the whole tree. colibri's own `coli stop` reports success while
    leaving the engine binary alive holding a port; this does not."""
    print()
    # ollama is a shared service: never killed here, only its pinned model is
    # released.
    mine = lambda: [p for p in running() if p[1] != "ollama"]
    procs = mine()

    for pid, kind, _ in procs:
        try:
            os.kill(pid, signal.SIGTERM)
            say(f"{DIM}stopping {kind} (pid {pid}){OFF}")
        except (ProcessLookupError, PermissionError):
            pass

    if procs:
        deadline = time.time() + 8
        while time.time() < deadline and mine():
            time.sleep(0.3)
        for pid, kind, _ in mine():
            try:
                os.kill(pid, signal.SIGKILL)
                say(f"{DIM}forcing {kind} (pid {pid}){OFF}")
            except (ProcessLookupError, PermissionError):
                pass
        time.sleep(0.4)

    # Runs on every path — including "nothing running", which is exactly the
    # case after an interface was killed and left its model pinned.
    for name in unpin_orphans():
        say(f"{DIM}unloaded {name} from GPU memory{OFF}")

    left = mine()
    if left:
        say(f"{len(left)} process(es) would not die", RED)
        print()
        return 1
    if not procs:
        say(f"{DIM}nothing of ours running · RAM released{OFF}")
    else:
        say(f"{AMBER}stopped{OFF}{DIM} · RAM released · ports free{OFF}")
    print()
    return 0


def ollama_cmd(sub, rest):
    """chat / run against the ollama backend. Returns None if not applicable,
    so the caller can fall through to colibri."""
    if sub not in ("chat", "run"):
        return None
    model = os.environ.get("ORIEL_MODEL", DEFAULT_OLLAMA_MODEL)
    # allow `oriel chat --model qwen3.5:9b`
    if "--model" in rest:
        i = rest.index("--model")
        if i + 1 < len(rest):
            model = rest[i + 1]
            rest = rest[:i] + rest[i + 2:]
    owned = start_ollama()
    t0 = time.time()
    while not ollama_up():
        if time.time() - t0 > 60:
            say("ollama did not come up", RED)
            return 1
        time.sleep(0.3)
    if not ollama_has(model):
        say(f"model not pulled: {model}", RED)
        say(f"{DIM}run: ollama pull {model}{OFF}")
        return 1
    binary = OLLAMA_BIN if Path(OLLAMA_BIN).is_file() else "ollama"
    prompt = [x for x in rest if not x.startswith("-")]
    args = [binary, "run", model] + ([" ".join(prompt)] if prompt else [])
    try:
        return subprocess.call(args)
    except KeyboardInterrupt:
        return 0
    finally:
        # leave ollama running only if it was already the user's
        if owned is not None:
            _kill_tree(owned)


def delegate(sub, rest):
    """Hand a subcommand to colibri with the model already filled in."""
    coli = Path(os.environ.get("ORIEL_COLI", DEFAULT_COLI))
    if not coli.is_file():
        say(f"colibri launcher not found: {coli}", RED)
        return 1
    if sub == "dashboard":
        sub = "web"
    args = [sys.executable, str(coli), sub, *rest]
    if "--model" not in rest:
        args += ["--model", os.environ.get("COLI_MODEL", str(DEFAULT_MODEL))]
    env = {**os.environ, "ORIEL_BRAND": "1"}  # show the oriel banner, not colibri's
    try:
        return subprocess.call(args, env=env)
    except KeyboardInterrupt:
        return 0


def main():
    argv = sys.argv[1:]

    if argv and argv[0] in ("help", "--help", "-h"):
        print(HELP)
        return 0
    if argv and argv[0] == "stop":
        return cmd_stop()
    if argv and argv[0] in ("ps", "status"):
        return cmd_ps()
    if argv and argv[0] in PASSTHROUGH:
        # chat/run go to ollama by default; the colibri-only commands
        # (doctor, plan, tune, dashboard…) still fall through to coli.
        if os.environ.get("ORIEL_BACKEND", "ollama") == "ollama":
            r = ollama_cmd(argv[0], argv[1:])
            if r is not None:
                return r
            if argv[0] in ("doctor", "plan", "tune", "dashboard", "bench", "mirror"):
                model_dir = Path(os.environ.get("COLI_MODEL", DEFAULT_MODEL))
                if not model_dir.is_dir():
                    say(f"`oriel {argv[0]}` needs a colibri model, and none is installed.", RED)
                    say(f"{DIM}that command is colibri-only; you are on the ollama backend{OFF}")
                    say(f"{DIM}try: oriel chat · oriel run \"...\" · oriel ps{OFF}")
                    return 1
        return delegate(argv[0], argv[1:])
    if argv and not argv[0].startswith("-"):
        say(f"unknown command: {argv[0]}", RED)
        say(f"{DIM}try: oriel help{OFF}")
        return 1

    # No subcommand — start the interface.
    return serve_app(argv)


if __name__ == "__main__":
    sys.exit(main())
