#!/usr/bin/env python3
"""oriel.ai — a local mind, running on your own machine.

One command for everything. With no arguments it starts the engine, serves the
oriel.ai interface and proxies the API through a single origin so the browser
never has to deal with CORS. With a subcommand it drives the engine directly.

    oriel                   start the interface and open the browser
    oriel chat              talk to the model in this terminal
    oriel run "..."         one-shot prompt, no session
    oriel stop              stop everything, including orphans
    oriel ps                show what is running
    oriel help              every command

Anything it does not recognise is passed through to colibri with the model
already filled in, so `oriel doctor`, `oriel plan`, `oriel tune` all work.

Nothing here touches the network. The engine reads weights from local disk and
the interface is served from local files.
"""

import argparse
import http.client
import http.server
import json
import os
import re
import signal
import socket
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
import webbrowser
from pathlib import Path

HERE = Path(__file__).resolve().parent
UI_DIR = HERE / "ui"
sys.path.insert(0, str(HERE))
from services import documents, exporter, macapp, store, tokens, web  # noqa: E402

CONTEXT_TOKENS = 32768   # measured: 4K → 32K costs gemma4 about 0.1 GB of RAM
KEEP_WARM = "20m"        # the page refreshes this while open; closed, RAM frees itself

DEFAULT_COLI = Path.home() / "colibri" / "c" / "coli"
DEFAULT_MODEL = Path.home() / "colibri" / "models" / "olmoe"

# Ollama backend (the default): Metal-accelerated on Apple Silicon, and the
# only way to run a model newer than colibri's roster allows on 16 GB.
OLLAMA_BIN = "/opt/homebrew/opt/ollama/bin/ollama"
OLLAMA_PORT = 11434
DEFAULT_OLLAMA_MODEL = "gemma4:e4b-it-qat"

DIM = "\033[2m"
BOLD = "\033[1m"
AMBER = "\033[38;5;179m"
RED = "\033[38;5;167m"
OFF = "\033[0m"
TTY = sys.stdout.isatty()
if not TTY:  # the login item writes to a log file: no colour codes, no spinners
    DIM = BOLD = AMBER = RED = OFF = ""
LOGS = macapp.LOGS


def say(msg, style=""):
    sys.stdout.write(f"  {style}{msg}{OFF}\n")
    sys.stdout.flush()


def free_port(preferred):
    """Return `preferred` if it is free, otherwise an arbitrary open port."""
    with socket.socket() as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", preferred))
            return preferred
        except OSError:
            pass
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def already_serving(port):
    """True if an oriel.ai interface is already up on this port.

    Without this check a second `oriel` silently falls back to a random port
    and you end up with two full stacks running, each holding RAM.
    """
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=1.5) as r:
            return r.status == 200 and b"oriel" in r.read(4096).lower()
    except Exception:
        return False


def ollama_up(timeout=1.5):
    try:
        with urllib.request.urlopen(
            f"http://127.0.0.1:{OLLAMA_PORT}/api/tags", timeout=timeout
        ) as r:
            return r.status == 200
    except Exception:
        return False


def ollama_has(model):
    """Is this model actually pulled? Names may carry an implicit :latest."""
    try:
        with urllib.request.urlopen(
            f"http://127.0.0.1:{OLLAMA_PORT}/api/tags", timeout=3
        ) as r:
            names = {m.get("name", "") for m in json.load(r).get("models", [])}
    except Exception:
        return False
    return model in names or f"{model}:latest" in names or any(
        n.split(":")[0] == model.split(":")[0] for n in names)


def ollama_keep(model, keep):
    """Load-and-pin (keep=-1) or unload (keep=0) a model.

    Measured: after 5 idle minutes ollama drops the model, and the next message
    takes 4.8 s to its first word instead of 0.14 s — 34x — almost all of it
    reloading weights. Only /api/generate honours keep_alive; the /v1 endpoint
    the interface talks to ignores it, but also does not reset a pin. So oriel
    pins on start and unpins on stop.
    """
    body = json.dumps({"model": model, "keep_alive": keep}).encode()
    req = urllib.request.Request(
        f"http://127.0.0.1:{OLLAMA_PORT}/api/generate", data=body,
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            r.read()
        return True
    except Exception:
        return False


def _engine_log():
    """The engine's own output, kept for `oriel logs`; rotated past 5 MB."""
    LOGS.mkdir(parents=True, exist_ok=True)
    path = LOGS / "engine.log"
    try:
        if path.stat().st_size > 5 * 1024 * 1024:
            path.replace(LOGS / "engine.log.1")
    except FileNotFoundError:
        pass
    return open(path, "ab")


def start_ollama():
    """Bring ollama up if it isn't. Returns the process if we started it, else
    None — so shutdown only stops a server we own, never the user's own."""
    if ollama_up():
        return None
    binary = OLLAMA_BIN if Path(OLLAMA_BIN).is_file() else "ollama"
    log = None if os.environ.get("ORIEL_VERBOSE") == "1" else _engine_log()
    proc = subprocess.Popen(
        [binary, "serve"],
        stdout=log, stderr=log,
        env={**os.environ, "OLLAMA_FLASH_ATTENTION": "1", "OLLAMA_KV_CACHE_TYPE": "q8_0",
             "OLLAMA_CONTEXT_LENGTH": str(CONTEXT_TOKENS)},
        start_new_session=True,
    )
    if log:
        log.close()  # the engine has its own copy
    return proc


ENGINE = {"proc": None}           # the ollama this process started, if any
_revive = threading.Lock()


def revive_engine():
    """If the engine has died or been stopped, start it again. True once it
    answers. Without this, one engine crash would break every window until
    the whole server was restarted by hand."""
    with _revive:
        if ollama_up():
            return True
        proc = start_ollama()
        if proc is not None:
            ENGINE["proc"] = proc
        deadline = time.time() + 30
        while time.time() < deadline:
            if ollama_up():
                return True
            time.sleep(0.3)
        return False


def engine_ready(port, timeout=1.5):
    try:
        with urllib.request.urlopen(
            f"http://127.0.0.1:{port}/health", timeout=timeout
        ) as r:
            return r.status == 200
    except Exception:
        return False


class Handler(http.server.BaseHTTPRequestHandler):
    """Serves the UI from disk and proxies everything else to the engine."""

    engine_port = 0
    ui_port = 7171
    backend = "ollama"
    model_id = DEFAULT_OLLAMA_MODEL
    protocol_version = "HTTP/1.1"

    # ---------- who may talk to us ----------

    def _allowed(self):
        """Refuse anything that isn't oriel's own page (or a local tool).

        Any website open in a browser can send requests to 127.0.0.1, and with
        DNS rebinding a hostile page can even become "same-origin" with this
        server and read chats. Two checks close both holes:
          - Host must be this server's own loopback name. A rebinding attack
            arrives with the attacker's hostname here.
          - Origin, when the browser sends one, must be this server. A normal
            cross-site request carries the other site's origin.
        """
        ok_hosts = {f"127.0.0.1:{self.ui_port}", f"localhost:{self.ui_port}"}
        if self.headers.get("Host", "") not in ok_hosts:
            self.send_error(403, "Forbidden host")
            return False
        origin = self.headers.get("Origin")
        if origin and origin not in {f"http://{h}" for h in ok_hosts}:
            self.send_error(403, "Forbidden origin")
            return False
        return True

    def _json(self, obj, status=200):
        body = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _body(self, cap):
        n = int(self.headers.get("Content-Length") or 0)
        if n > cap:
            raise ValueError(f"request too large ({n // 1048576} MB)")
        return self.rfile.read(n) if n else b""

    # Quiet by default; the engine's own log is the interesting one.
    def log_message(self, fmt, *args):
        if os.environ.get("ORIEL_VERBOSE") == "1":
            sys.stderr.write("  [ui] %s\n" % (fmt % args))

    def handle_one_request(self):
        """A browser closing a tab or navigating away mid-request resets the
        socket, which socketserver would otherwise dump as a traceback into
        the user's terminal. It is normal, so swallow it."""
        try:
            super().handle_one_request()
        except (ConnectionResetError, BrokenPipeError, TimeoutError):
            self.close_connection = True

    # ---------- static ----------

    def _serve_file(self, rel):
        path = (UI_DIR / rel).resolve()
        if not str(path).startswith(str(UI_DIR)) or not path.is_file():
            self.send_error(404, "Not found")
            return
        ctype = {
            ".html": "text/html; charset=utf-8",
            ".css": "text/css; charset=utf-8",
            ".js": "text/javascript; charset=utf-8",
            ".svg": "image/svg+xml",
            ".png": "image/png",
            ".ico": "image/x-icon",
            ".json": "application/json",
            ".woff2": "font/woff2",
            ".woff": "font/woff",
            ".txt": "text/plain; charset=utf-8",
            ".webp": "image/webp",
        }.get(path.suffix, "application/octet-stream")
        body = path.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    # ---------- proxy ----------

    def _proxy(self, method):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None
        headers = {"Content-Type": self.headers.get("Content-Type", "application/json")}
        for attempt in (1, 2):
            conn = http.client.HTTPConnection("127.0.0.1", self.engine_port, timeout=900)
            try:
                conn.request(method, self.path, body=body, headers=headers)
                upstream = conn.getresponse()
                break
            except Exception as exc:
                conn.close()
                if attempt == 1 and self.backend == "ollama" and revive_engine():
                    continue
                self.send_error(502, f"engine unreachable: {exc}")
                return

        self.send_response(upstream.status)
        ctype = upstream.getheader("Content-Type", "application/json")
        self.send_header("Content-Type", ctype)
        # Stream token-by-token: no content-length, no buffering.
        self.send_header("Cache-Control", "no-store")
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        try:
            while True:
                chunk = upstream.read(1)
                if not chunk:
                    break
                self.wfile.write(b"%X\r\n%s\r\n" % (len(chunk), chunk))
                self.wfile.flush()
            self.wfile.write(b"0\r\n\r\n")
            self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass  # the browser navigated away mid-stream
        finally:
            conn.close()

    # ---------- routes ----------

    def _info(self):
        """What the page needs to know about the engine behind it — chiefly
        whether Decide (/v1/brio) exists, which is colibri-only."""
        body = json.dumps({
            "backend": self.backend,
            "model": self.model_id,
            "brio": self.backend == "colibri",
        }).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if not self._allowed():
            return
        path, _, query = self.path.partition("?")
        if path in ("/", "/index.html"):
            return self._serve_file("index.html")
        if path == "/oriel/info":
            return self._info()
        if path == "/oriel/state/rev":
            return self._json({"rev": store.state_rev()})
        if path == "/oriel/state":
            body = store.load_state()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        if path.startswith("/oriel/files/"):
            got = store.load_file(path.rsplit("/", 1)[-1])
            if not got:
                return self.send_error(404, "Not found")
            data, ctype = got
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "private, max-age=31536000, immutable")
            self.end_headers()
            self.wfile.write(data)
            return
        if path == "/oriel/search":
            q = urllib.parse.parse_qs(query).get("q", [""])[0]
            try:
                return self._json({"results": web.search(q)})
            except web.SearchError as e:
                return self._json({"error": str(e)}, 503)
        if path.startswith(("/v1/", "/health", "/api/")):
            return self._proxy("GET")
        return self._serve_file(path.lstrip("/"))

    def do_PUT(self):
        if not self._allowed():
            return
        if self.path == "/oriel/state":
            try:
                return self._json({"ok": True, "rev": store.save_state(self._body(store.MAX_STATE))})
            except store.Conflict as e:
                self.send_response(409)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(e.current)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(e.current)
                return
            except (ValueError, json.JSONDecodeError) as e:
                return self._json({"error": str(e)}, 400)
        self.send_error(404, "Not found")

    def do_POST(self):
        if not self._allowed():
            return
        path = self.path.split("?", 1)[0]
        name = urllib.parse.unquote(self.headers.get("X-Filename", "file"))
        try:
            if path == "/oriel/files":
                data = self._body(store.MAX_FILE)
                return self._json(store.save_file(data, name, self.headers.get("Content-Type", "")))
            if path == "/oriel/extract":
                text, note = documents.extract_text(self._body(store.MAX_FILE), name)
                return self._json({"text": text, "note": note})
            if path == "/oriel/export":
                req = json.loads(self._body(8 * 1024 * 1024))
                out = exporter.export(req.get("title", "oriel"), req.get("text", ""), req.get("format", "md"))
                return self._json({"path": str(out), "name": out.name})
            if path == "/oriel/reveal":
                exporter.reveal(json.loads(self._body(4096)).get("path", ""))
                return self._json({"ok": True})
            if path == "/oriel/tokens":
                req = json.loads(self._body(32 * 1024 * 1024))
                return self._json({"counts": tokens.count(req.get("model"), req.get("texts"))})
        except documents.Unsupported as e:
            return self._json({"error": f"can't read {e} files"}, 415)
        except (ValueError, json.JSONDecodeError) as e:
            return self._json({"error": str(e)}, 400)
        except Exception as e:
            return self._json({"error": str(e)[:300]}, 500)
        if path.startswith(("/v1/", "/health", "/api/")):
            return self._proxy("POST")
        self.send_error(404, "Not found")


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request, client_address):
        """Same reasoning as handle_one_request: a dropped client connection is
        routine, not something to print a stack trace about."""
        exc = sys.exc_info()[1]
        if isinstance(exc, (ConnectionResetError, BrokenPipeError, TimeoutError)):
            return
        super().handle_error(request, client_address)


def serve_app(argv):
    ap = argparse.ArgumentParser(prog="oriel", description="oriel.ai — local AI")
    ap.add_argument("--port", type=int, default=7171, help="interface port")
    ap.add_argument("--model", default=None,
                    help="ollama model name, or a colibri model directory")
    ap.add_argument("--backend", choices=("ollama", "colibri"), default="ollama",
                    help="ollama (default, Metal-accelerated) or colibri")
    ap.add_argument("--coli", default=str(DEFAULT_COLI), help="path to the coli launcher")
    # 10 GB is measured, not guessed: it is the point where the engine caches
    # 64/64 experts per layer (100% residency, nothing streamed from disk).
    # At 5 GB it cached 23/64 and ran roughly half as fast. Real footprint is
    # ~3.2 GB — the budget is a ceiling, not an allocation.
    ap.add_argument("--ram", default="10", help="engine RAM budget in GB")
    ap.add_argument("--no-browser", action="store_true")
    # --service: how the login item runs it. No browser, no warm-up (nothing
    # sits in RAM until a window actually opens), and never a fallback port —
    # the app expects 7171.
    ap.add_argument("--service", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    if a.service:
        a.no_browser = True

    # `--model` means different things per backend (an ollama tag vs a
    # directory), so it is resolved inside each branch, not here.
    coli = Path(a.coli)
    print()
    say(f"{BOLD}oriel.ai{OFF}{DIM} · a local mind{OFF}")
    print()

    # Don't start a second stack on a fallback port — point at the live one.
    if already_serving(a.port):
        if a.service:  # e.g. an `oriel` running in a terminal: let it be
            say("another oriel server is already answering on this port — nothing to do")
            return 0
        url = f"http://127.0.0.1:{a.port}"
        say(f"already running at {BOLD}{url}{OFF}")
        say(f"{DIM}`oriel stop` to shut it down, `oriel ps` to see it{OFF}")
        print()
        if not a.no_browser:
            webbrowser.open(url)
        return 0

    # ---------------- ollama backend (default) ----------------
    if a.backend == "ollama":
        model_id = a.model or os.environ.get("ORIEL_MODEL", DEFAULT_OLLAMA_MODEL)
        ui_port = free_port(a.port)
        if a.service and ui_port != a.port:
            say(f"port {a.port} is taken by something else", RED)
            return 1

        say(f"model    {model_id}")
        if a.service:
            # If the previous server was force-killed, its engine lives on as an
            # orphan; replace it, so this server owns (and logs) its engine.
            for pid in orphaned_engines():
                os.kill(pid, signal.SIGTERM)
                say(f"replacing an engine left over by an earlier oriel (pid {pid})")
            deadline = time.time() + 10
            while time.time() < deadline and orphaned_engines():
                time.sleep(0.3)
        owned = start_ollama()
        t0 = time.time()
        spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        i = 0
        while not ollama_up():
            if owned is not None and owned.poll() is not None:
                print()
                say("ollama exited while starting", RED)
                say(f"{DIM}try: {OLLAMA_BIN} serve{OFF}")
                return 1
            if TTY:
                sys.stdout.write(f"\r  {AMBER}{spinner[i % len(spinner)]}{OFF} "
                                 f"{DIM}starting ollama… {time.time()-t0:0.0f}s{OFF}   ")
                sys.stdout.flush()
            i += 1
            time.sleep(0.1)
            if time.time() - t0 > 60:
                print(); say("ollama did not come up", RED); return 1
        if TTY:
            sys.stdout.write("\r" + " " * 48 + "\r")

        if not ollama_has(model_id):
            say(f"model not pulled: {model_id}", RED)
            say(f"{DIM}run: ollama pull {model_id}{OFF}")
            return 1
        say(f"engine   {AMBER}ollama{OFF}{DIM} · Metal · 127.0.0.1:{OLLAMA_PORT}{OFF}")

        # Load the weights now rather than on the first message. Held for
        # KEEP_WARM, which the open page keeps refreshing — so the model stays
        # warm while oriel is in use, and frees its RAM by itself after it is
        # closed. As a login service, don't load anything until a window opens.
        if not a.service:
            t0 = time.time()
            sys.stdout.write(f"  {DIM}warming  loading into GPU memory…{OFF}")
            sys.stdout.flush()
            warmed = ollama_keep(model_id, KEEP_WARM)
            sys.stdout.write("\r" + " " * 48 + "\r")
            if warmed:
                say(f"warm     {AMBER}ready{OFF}{DIM} in {time.time()-t0:0.1f}s · stays loaded while oriel is open{OFF}")
            else:
                say(f"{DIM}warm     skipped — first message will load the model{OFF}")

        ENGINE["proc"] = owned
        Handler.engine_port = OLLAMA_PORT
        Handler.backend = "ollama"
        Handler.model_id = model_id
        # the interface can switch models and move the pin, so on stop release
        # whatever is pinned rather than only the model we started with
        return _serve_ui(ui_port, a.no_browser, owned,
                         on_stop=lambda: (ollama_keep(model_id, 0), unpin_orphans()))

    # ---------------- colibri backend ----------------
    model = Path(a.model or DEFAULT_MODEL)
    if not coli.is_file():
        say(f"engine launcher not found: {coli}", RED)
        say("pass --coli /path/to/coli", DIM)
        return 1
    if not model.is_dir():
        say(f"model not found: {model}", RED)
        say("pass --model /path/to/model", DIM)
        return 1

    engine_port = free_port(8012)
    ui_port = free_port(a.port)

    say(f"model    {model.name}{DIM}  ({model}){OFF}")
    say(f"engine   {DIM}starting on 127.0.0.1:{engine_port}{OFF}")

    proc = subprocess.Popen(
        [
            sys.executable, str(coli), "serve",
            "--model", str(model),
            "--ram", str(a.ram),
            "--port", str(engine_port),
            "--host", "127.0.0.1",
        ],
        stdout=subprocess.DEVNULL if os.environ.get("ORIEL_VERBOSE") != "1" else None,
        stderr=subprocess.DEVNULL if os.environ.get("ORIEL_VERBOSE") != "1" else None,
        # Own session/process group: the engine spawns its own C binary as a
        # child, and signalling only `coli` would leave that binary orphaned
        # holding the port. Killing the group takes the whole tree down.
        start_new_session=True,
    )

    spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    t0 = time.time()
    i = 0
    while not engine_ready(engine_port):
        if proc.poll() is not None:
            print()
            say("the engine exited while loading", RED)
            say("run with ORIEL_VERBOSE=1 to see why", DIM)
            return 1
        sys.stdout.write(
            f"\r  {AMBER}{spinner[i % len(spinner)]}{OFF} "
            f"{DIM}loading weights… {time.time() - t0:0.0f}s{OFF}   "
        )
        sys.stdout.flush()
        i += 1
        time.sleep(0.1)
    sys.stdout.write("\r" + " " * 48 + "\r")
    say(f"engine   {AMBER}ready{OFF}{DIM} in {time.time() - t0:0.1f}s{OFF}")

    Handler.engine_port = engine_port
    Handler.backend = "colibri"
    Handler.model_id = "olmoe-colibri"
    return _serve_ui(ui_port, a.no_browser, proc)


def _serve_ui(ui_port, no_browser, proc, on_stop=None):
    """Serve the interface and block until stopped.

    `proc` is the engine we started, or None when we attached to one the user
    was already running — in that case shutdown leaves it alone. `on_stop` runs
    first either way (the ollama backend uses it to unpin the model).
    """
    Handler.ui_port = ui_port
    httpd = Server(("127.0.0.1", ui_port), Handler)
    url = f"http://127.0.0.1:{ui_port}"
    say(f"open     {BOLD}{url}{OFF}")
    print()
    say(f"{DIM}offline · nothing leaves this machine · "
        f"{'running in the background · `oriel stop` stops it' if not TTY else 'ctrl-c to stop'}{OFF}")
    print()

    if not no_browser:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()

    def shutdown(*_):
        print()
        say(f"{DIM}stopping…{OFF}")
        if on_stop is not None:
            try:
                on_stop()
            except Exception:
                pass
        engine = ENGINE["proc"] or proc   # may have been restarted since
        if engine is None:
            say(f"{DIM}stopped · model unloaded · RAM released (ollama left running){OFF}")
            print()
            os._exit(0)
        _kill_tree(engine)
        say(f"{DIM}stopped · RAM released{OFF}")
        print()
        os._exit(0)

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)
    # Closing the terminal window sends SIGHUP; without this the launcher
    # dies on the spot and leaves the engine running, orphaned, holding RAM.
    signal.signal(signal.SIGHUP, shutdown)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        shutdown()
    return 0


def _kill_tree(proc):
    """SIGTERM then SIGKILL the whole process group — the engine spawns its own
    child binary, and signalling only the direct child orphans it on a port."""
    try:
        pgid = os.getpgid(proc.pid)
    except Exception:
        pgid = None
    try:
        if pgid is not None:
            os.killpg(pgid, signal.SIGTERM)
        else:
            proc.terminate()
        proc.wait(timeout=10)
    except Exception:
        pass
    if pgid is not None:
        try:
            os.killpg(pgid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass


